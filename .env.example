# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     Copy-Item .env.example .env      (PowerShell)
#
# `.env` is ignored by git. This file (.env.example) IS committed — it
# documents which settings the app needs, without exposing any real values.
#
# NEVER put a real key in THIS file. This one goes into git history forever.
# ---------------------------------------------------------------------------

# Required. Get a free key at https://console.groq.com  ->  API Keys
GROQ_API_KEY=your_groq_api_key_here

# Which model on Groq to call.
#
# NOTE: Groq decommissions models periodically, so always verify yours:
#     python -c "from backend.services.groq_client import get_client; \
#                print([m.id for m in get_client().models.list().data])"
#
# AVOID the openai/gpt-oss-* models for this app. They are REASONING models:
# they spend 100+ hidden tokens thinking before writing any visible answer.
# With a small max_tokens the entire budget is consumed by reasoning and the
# response comes back empty. That breaks short outputs (explanations,
# interview questions) and roughly doubles cost per call.
#
# qwen/qwen3.8-27b answers directly with no reasoning overhead and is the
# most token-efficient option tested. openai/gpt-oss-120b gives slightly
# richer prose if you need it, at ~2x the tokens.
GROQ_MODEL=qwen/qwen3.8-27b

# SDK-level retries for transient failures (timeouts, 5xx). 0-5.
GROQ_MAX_RETRIES=2

# Seconds to wait for Groq before giving up.
GROQ_TIMEOUT_SECONDS=30

# Where the FastAPI backend runs (used by the Streamlit frontend).
BACKEND_URL=http://127.0.0.1:8000

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Free-form label for the environment: development | production
APP_ENV=development
