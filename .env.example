# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     Copy-Item .env.example .env      (PowerShell)
#
# `.env` is ignored by git. This file (.env.example) IS committed — it
# documents which settings the app needs, without exposing any real values.
#
# NEVER put a real key in THIS file. This one goes into git history forever.
# ---------------------------------------------------------------------------

# Required. Get a free key at https://console.groq.com  ->  API Keys
GROQ_API_KEY=your_groq_api_key_here

# Which model on Groq to call.
GROQ_MODEL=llama-3.3-70b-versatile

# Seconds to wait for Groq before giving up.
GROQ_TIMEOUT_SECONDS=30

# Where the FastAPI backend runs (used by the Streamlit frontend).
BACKEND_URL=http://127.0.0.1:8000

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Free-form label for the environment: development | production
APP_ENV=development
